# ==============================================================================
# M500 sync configuration — TEMPLATE
# ------------------------------------------------------------------------------
# Copy this file to  tools/m500-sync.env  and fill in your own values.
# tools/m500-sync.env is gitignored and must NEVER be committed — it holds the
# personal host/IP of your ingestion server. This .example file carries no real
# data (values are RFC 5737 TEST-NET-1 placeholders, 192.0.2.x) and is safe to
# commit.
#
# Consumed by: tools/m500-sync.sh, tools/rsync/m500-sync.sh, tools/sync-library.sh
# ------------------------------------------------------------------------------

# Ingestion / rsync server host. Leave EMPTY to use USB-only (adb port-forward over
# 127.0.0.1) and let the app auto-discover on Wi-Fi. Set it to your M500's Wi-Fi
# address (or DNS name) to enable the direct Wi-Fi transport.
#   Example: SYNC_HOST=192.0.2.10
SYNC_HOST=

# rsync daemon port. 8730 is the M500 default (a protocol constant, not personal data).
SYNC_PORT=8730

# adb-over-Wi-Fi TCP port used by tools/sync-library.sh to build ANDROID_SERIAL
# (as ${SYNC_HOST}:${ADB_TCP_PORT}). Standard Android wireless-debug port is 5555.
ADB_TCP_PORT=5555
