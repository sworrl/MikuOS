<?xml version="1.0" encoding="utf-8"?>
<!-- MikuOS splash art overlay: replaces the frames of HiBy's SystemUI popup animations
     (headphones in/out, charging, low battery, low-power shutdown, shutdown/reboot,
     high-volume warning, HiBy volume dial) and the shutdown backdrop, by resource name.
     The anim_miku_* animation-lists, layouts and code are untouched; only the PNGs change.
     res/ is generated by mikuos/art/hiby-splash/build_frames.py, do not hand-edit it.
     Static, baked into /product/overlay like the other MikuOS RROs. <application> is required
     or PackageManager rejects the APK. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.miku.splash.overlay"
    android:versionCode="1"
    android:versionName="1.0">
    <application android:hasCode="false" android:label="MikuOS Splash Art Overlay" />
    <overlay
        android:targetPackage="com.android.systemui"
        android:priority="998"
        android:isStatic="true" />
</manifest>
