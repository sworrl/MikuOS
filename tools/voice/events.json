{
  "version": 1,
  "notes": "Status announcements. Key = event id = file stem. phrases[0] is the default, the rest are alternates a player can rotate through. Phrases are plain US English: a friendly person stating what happened, short, no emojis. 'source' is a hint for whoever wires the event up, not a contract. Numbers are spelled out so the synthesizer never has to guess.",
  "events": {
    "iem_connected_35mm": {
      "category": "audio_output",
      "priority": "info",
      "source": "AudioDeviceCallback added TYPE_WIRED_HEADSET/TYPE_WIRED_HEADPHONES on the 3.5 mm jack",
      "phrases": [
        "IEMs connected.",
        "IEMs plugged in."
      ]
    },
    "iem_connected_44mm": {
      "category": "audio_output",
      "priority": "info",
      "source": "AudioDeviceCallback added wired device on the 4.4 mm balanced jack (HiBy jack-detect)",
      "phrases": [
        "Balanced IEMs connected.",
        "Balanced output connected."
      ]
    },
    "iem_removed_35mm": {
      "category": "audio_output",
      "priority": "info",
      "source": "AudioDeviceCallback removed 3.5 mm wired device / ACTION_AUDIO_BECOMING_NOISY",
      "phrases": [
        "IEMs unplugged.",
        "Your IEMs are unplugged."
      ]
    },
    "iem_removed_44mm": {
      "category": "audio_output",
      "priority": "info",
      "source": "AudioDeviceCallback removed 4.4 mm balanced device / ACTION_AUDIO_BECOMING_NOISY",
      "phrases": [
        "Balanced IEMs unplugged.",
        "Balanced output removed."
      ]
    },
