{
  "version": 1,
  "notes": "Sounds for MikuOS apps. 'voice' lines render in every house voice to mikuos/data/voice/<voice>/app/<app>/<id>.ogg (alternates as <id>_alt1.ogg). 'sfx' render once to mikuos/data/sfx/<app>/<id>.ogg from the named recipe in sfx.py. lufs is the max momentary loudness target for one-shots and integrated loudness for loops. Phrase style matches events.json: plain US English, short, friendly, no emojis.",
  "apps": {
    "camera": {
      "voice": {
        "say_cheese": {
          "phrases": [
            "Say cheese!"
          ]
        },
        "smile": {
          "phrases": [
            "Smile!"
          ]
        },
        "got_it": {
          "phrases": [
            "Got it!"
          ]
        },
        "photo_saved": {
          "phrases": [
            "Photo saved."
          ]
        },
        "video_recording": {
          "phrases": [
            "Recording."
          ]
        },
        "video_stopped": {
          "phrases": [
            "Video stopped."
          ]
        },
        "video_saved": {
          "phrases": [
            "Video saved."
          ]
        },
        "countdown": {
          "phrases": [
            "Three, two, one!"
          ],
          "note": "quick spoken countdown, about 1 s, for right before the shot"
        },
        "countdown_timed": {
          "compose": [
            "count_3",
            "count_2",
            "count_1"
          ],
          "spacing": 1.0,
          "text": "Three. Two. One.",
          "note": "one number per second, starting at 0.03 s; fire the shutter at 3.0 s. Built from count_3, count_2, count_1"
        },
        "count_3": {
          "phrases": [
            "Three."
          ],
          "note": "per-second countdown: play with timer_beep at t-3"
        },
        "count_2": {
          "phrases": [
            "Two."
          ]
        },
        "count_1": {
          "phrases": [
            "One."
          ]
        },
        "camera_switched": {
          "phrases": [
            "Camera switched."
          ]
        },
        "flash_on": {
          "phrases": [
            "Flash on."
          ]
        },
        "flash_off": {
          "phrases": [
            "Flash off."
          ]
        },
        "flash_auto": {
          "phrases": [
            "Flash on auto."
          ]
        },
        "hold_still": {
          "phrases": [
            "Hold still."
          ],
          "note": "night or long exposure capture"
        },
        "storage_almost_full": {
          "phrases": [
            "Storage is almost full."
          ]
        }
      },
      "sfx": {
        "shutter": {
          "recipe": "shutter_miku",
          "lufs": -20,
          "note": "single shot: two-blade shutter plus a short bell sparkle"
        },
        "shutter_burst": {
          "recipe": "shutter_plain",
          "lufs": -20,
          "note": "burst mode, dry and about 120 ms so shots do not smear"
        },
        "video_start": {
          "recipe": "video_start",
          "lufs": -20
        },
        "video_stop": {
          "recipe": "video_stop",
          "lufs": -20
        },
        "focus_lock": {
          "recipe": "focus_lock",
          "lufs": -24,
          "note": "two tiny pips"
        },
        "timer_beep": {
          "recipe": "timer_beep",
          "lufs": -20,
          "note": "once per second during the self-timer"
        },
        "timer_beep_final": {
          "recipe": "timer_beep_final",
          "lufs": -20,
          "note": "the last beep, right before the shutter"
        }
      }
    },
    "recorder": {
      "voice": {
        "recording_started": {
          "phrases": [
            "Recording started."
          ]
        },
        "paused": {
          "phrases": [
            "Recording paused."
          ]
        },
        "resumed": {
          "phrases": [
            "Recording resumed."
          ]
        },
        "saved": {
          "phrases": [
            "Recording saved."
          ]
        }
      },
      "sfx": {
        "start": {
          "recipe": "rec_start",
          "lufs": -20
        },
        "stop": {
          "recipe": "rec_stop",
          "lufs": -20
        },
        "pause": {
          "recipe": "rec_pause",
          "lufs": -20
        }
      }
    },
    "clock": {
