<?xml version="1.0" encoding="utf-8"?>
<!-- MikuOS default runtime-permission grants. The DefaultPermissionGrantPolicy
     auto-grants these at first boot so system apps don't prompt. Location is
     required for Wi-Fi scanning (getScanResults) and weather/scrobble; without
     it the launcher's Wi-Fi scanner returns nothing. fixed="false" lets the
     user still revoke it. -->
<exceptions>
    <exception package="com.miku.launcher">
        <permission name="android.permission.READ_MEDIA_AUDIO" fixed="false"/>
        <permission name="android.permission.ACCESS_FINE_LOCATION" fixed="false"/>
        <permission name="android.permission.ACCESS_COARSE_LOCATION" fixed="false"/>
        <permission name="android.permission.BLUETOOTH_CONNECT" fixed="false"/>
        <permission name="android.permission.BLUETOOTH_SCAN" fixed="false"/>
        <permission name="android.permission.BLUETOOTH_ADVERTISE" fixed="false"/>
        <permission name="android.permission.NEARBY_WIFI_DEVICES" fixed="false"/>
    </exception>
    <exception package="com.miku.player">
        <permission name="android.permission.ACCESS_FINE_LOCATION" fixed="false"/>
        <permission name="android.permission.ACCESS_COARSE_LOCATION" fixed="false"/>
        <permission name="android.permission.READ_MEDIA_AUDIO" fixed="false"/>
        <permission name="android.permission.POST_NOTIFICATIONS" fixed="false"/>
        <permission name="android.permission.BLUETOOTH_CONNECT" fixed="false"/>
        <permission name="android.permission.BLUETOOTH_SCAN" fixed="false"/>
        <permission name="android.permission.BLUETOOTH_ADVERTISE" fixed="false"/>
        <permission name="android.permission.NEARBY_WIFI_DEVICES" fixed="false"/>
    </exception>
    <exception package="com.miku.systemui">
        <permission name="android.permission.ACCESS_FINE_LOCATION" fixed="false"/>
        <permission name="android.permission.ACCESS_COARSE_LOCATION" fixed="false"/>
        <permission name="android.permission.POST_NOTIFICATIONS" fixed="false"/>
        <permission name="android.permission.BLUETOOTH_CONNECT" fixed="false"/>
        <permission name="android.permission.BLUETOOTH_SCAN" fixed="false"/>
        <permission name="android.permission.BLUETOOTH_ADVERTISE" fixed="false"/>
        <permission name="android.permission.NEARBY_WIFI_DEVICES" fixed="false"/>
    </exception>
    <exception package="com.miku.settings">
        <permission name="android.permission.ACCESS_FINE_LOCATION" fixed="false"/>
        <permission name="android.permission.ACCESS_COARSE_LOCATION" fixed="false"/>
        <permission name="android.permission.BLUETOOTH_CONNECT" fixed="false"/>
        <permission name="android.permission.BLUETOOTH_SCAN" fixed="false"/>
        <permission name="android.permission.BLUETOOTH_ADVERTISE" fixed="false"/>
        <permission name="android.permission.NEARBY_WIFI_DEVICES" fixed="false"/>
    </exception>
    <exception package="com.miku.media">
        <permission name="android.permission.CAMERA" fixed="false"/>
        <permission name="android.permission.RECORD_AUDIO" fixed="false"/>
        <permission name="android.permission.READ_MEDIA_IMAGES" fixed="false"/>
        <permission name="android.permission.READ_MEDIA_VIDEO" fixed="false"/>
        <permission name="android.permission.READ_MEDIA_AUDIO" fixed="false"/>
        <permission name="android.permission.ACCESS_MEDIA_LOCATION" fixed="false"/>
        <permission name="android.permission.POST_NOTIFICATIONS" fixed="false"/>
    </exception>
    <exception package="com.miku.tools">
        <permission name="android.permission.READ_CALENDAR" fixed="false"/>
        <permission name="android.permission.WRITE_CALENDAR" fixed="false"/>
        <permission name="android.permission.POST_NOTIFICATIONS" fixed="false"/>
    </exception>
    <exception package="com.miku.riot">
        <permission name="android.permission.READ_MEDIA_AUDIO" fixed="false"/>
    </exception>
    <exception package="com.miku.wheel">
        <permission name="android.permission.READ_MEDIA_AUDIO" fixed="false"/>
    </exception>
</exceptions>
